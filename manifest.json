{
  "manifest_version": 3,
  "name": "Ziqi Tab",
  "version": "1.0.0",
  "description": "\u6781\u7b80\u3001\u6696\u8c03\u7d20\u7eb8\u98ce\u683c\u7684\u6d4f\u89c8\u5668\u8d77\u59cb\u9875",
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "favicon",
    "history"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

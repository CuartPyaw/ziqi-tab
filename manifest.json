{
  "manifest_version": 3,
  "name": "Ziqi Tab",
  "version": "1.0.0",
  "description": "极简、暖调素纸风格的浏览器起始页",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["bookmarks"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
